{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ashterism-walks-sync",
  "main": "src/index.js",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [{ "binding": "WALK_PREFERENCES", "id": "8298aced912a4fe29fa441653d881643" }],
  "vars": { "WALKS_ORIGINS": "https://walks.ashterism.com,http://localhost:5173,http://127.0.0.1:5173" },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
